{
  "name": "kunpeng-devkit-ai-tui",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "description": "Kunpeng DevKit AI native terminal engineering workspace",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": "1.3.14"
  },
  "scripts": {
    "dev": "bun --hot src/index.tsx",
    "start": "bun src/index.tsx",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "bun run test:unit && bun run test:integration && bun run test:render && bun run test:packaging",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:render": "bun test tests/render",
    "test:packaging": "vitest run tests/packaging",
    "package:all": "bun scripts/package-all.ts",
    "verify:packages": "bun scripts/verify-packages.ts",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run test",
    "release:check": "bun run check && bun run package:all && bun run verify:packages"
  },
  "dependencies": {
    "@opentui/core": "0.5.1",
    "@opentui/react": "0.5.1",
    "react": "19.2.0",
    "react-devtools-core": "7.0.1",
    "web-tree-sitter": "0.25.10",
    "ws": "8.18.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.11",
    "@types/bun": "1.3.14",
    "@types/node": "24.10.1",
    "@types/react": "19.2.18",
    "@types/ws": "8.18.1",
    "bun": "1.3.14",
    "typescript": "5.9.3",
    "vitest": "4.0.15"
  }
}
