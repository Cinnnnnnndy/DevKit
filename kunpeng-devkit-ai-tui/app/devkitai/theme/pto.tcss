/* PTO Design System → TCSS
 *
 * 色值一律引用 $pto-* 变量，变量由 devkitai/theme/__init__.py 从 tokens.py 生成。
 * 这个文件里**不许出现十六进制字面量**——出现即意味着规范有了第二份真值。
 *
 * 两条造型纪律（VISUAL.md §4 与"方形"那节）：
 *   · 圆角 = 浮起。列表项 / tab / 进度条一律直角；只有真正浮起的东西给圆角。
 *   · 间距只取 SPACE 六档，且列与行分开取值——终端单元格约 1:2，不是正方。
 */

Screen {
    background: $pto-background;
    color: $pto-fg;
}

/* ── Chrome 层：结构性元素是真组件，四态齐全 ───────────────────────────── */

#dock {
    width: 26;
    background: $pto-surface-2;
    border-right: solid $pto-border-subtle;
    padding: 1 2;          /* SPACE[4] = (2 col, 1 row) */
}

#dock .section {
    color: $pto-fg-muted;
    text-style: bold;
    margin-bottom: 1;
}

#dock ListItem {
    padding: 0 1;          /* SPACE[2] */
    color: $pto-fg-secondary;
}
#dock ListItem:hover { background: $pto-hover; color: $pto-fg; }
/* 选中态：整行同色 + 左侧实心竖条贴边，不只染标签 */
#dock ListItem.-highlight {
    background: $pto-selected;
    color: $pto-primary-text;
    border-left: thick $pto-primary;
}

#main { padding: 1 2; }

/* 并排的两张曲线：容器不给 height 会塌成一行，只剩表头看得见 */
#main > Horizontal { height: auto; }

.panel {
    background: $pto-surface-1;
    border: round $pto-border-default;   /* radius-lg → ╭╮╰╯，浮起才给圆角 */
    padding: 1 2;
    margin-bottom: 1;
}

/* 分区标题：全大写 + 字距，靠 muted 档与正文拉开层级，不靠字号（终端只有一级） */
.panel-title {
    color: $pto-fg-muted;
    text-style: bold;
}

.meta { color: $pto-fg-secondary; }
.rule { color: $pto-rule; }

/* 反色 chip —— pill 在终端没有对应形态，用「反色 + 前后各留一空格」表达 */
.chip {
    background: $pto-surface-3;
    color: $pto-fg;
    padding: 0 1;
}
.chip.-brand { background: $pto-primary; color: $pto-background; }

/* ── 焦点：终端没有外发光轮廓，用「底色 + 左标记 + 边框升档」三者组合 ──── */
.panel:focus-within {
    background: $pto-focus;
    border: round $pto-border-strong;
}

/* ── Canvas 层：数据区不加任何装饰，边框只做边界 ─────────────────────── */

#chart-cpu, #chart-npu, #heatmap {
    height: auto;
    background: $pto-surface-1;
}

DataTable {
    background: $pto-surface-1;
    color: $pto-fg-secondary;
}
DataTable > .datatable--header {
    background: $pto-surface-2;
    color: $pto-fg-muted;
    text-style: bold;
}
DataTable > .datatable--cursor {
    background: $pto-selected;
    color: $pto-primary-text;
}
DataTable > .datatable--hover { background: $pto-hover; }

/* ── keybar：反色键位 chip + 常规文字动作，比纯文本 keybar 易扫读一个量级 ── */
#keybar {
    dock: bottom;
    height: 1;
    background: $pto-surface-2;
    color: $pto-fg-muted;
    padding: 0 2;
}

#statusbar {
    dock: bottom;
    height: 1;
    background: $pto-surface-2;
    color: $pto-fg-secondary;
    padding: 0 2;
}
